{
	"name": "@empyria/moleculer",
	"version": "0.1.4",
	"description": "Moleculer helpers for Empyria",
	"license": "MIT",
	"author": "Imre Fazekas <imre.fazekas@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/empyria-nano/guard-moleculer.git"
	},
	"type": "module",
	"main": "./Mixins.js",
	"exports": {
		".": "./Mixins.js",
		"./Connector.js": "./Connector.js",
		"./mixins/*": "./mixins/*.js",
		"./util/*": "./util/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "bun oxfmt --check",
		"format:fix": "bun oxfmt",
		"lint": "bun oxlint",
		"lint:fix": "bun oxlint --fix",
		"test": "bun test --coverage",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@empyria/classification": "0.1.3",
		"@empyria/common": "0.1.4",
		"moleculer": "0.15.1"
	},
	"devDependencies": {
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=26"
	}
}
